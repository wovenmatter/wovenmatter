[Unit]
Description=Woven VM first-boot provisioning
After=network-online.target woven-agent.service
Wants=network-online.target
ConditionPathExists=!/var/lib/woven/provisioned

[Service]
Type=oneshot
ExecStart=/usr/local/lib/woven/provision.sh first-boot
TimeoutStartSec=10800

[Install]
WantedBy=multi-user.target
