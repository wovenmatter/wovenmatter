{
  "schemaVersion": 4,
  "harnesses": [
    {
      "id": "codex",
      "displayName": "Codex",
      "transport": "acp",
      "command": "codex-acp",
      "arguments": [],
      "cliCommand": "codex",
      "adapterPackage": "@agentclientprotocol/codex-acp",
      "minimumAdapterVersion": "1.13.1",
      "install": {
        "kind": "official-script",
        "source": "https://chatgpt.com/codex/install.sh",
        "command": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
        "interpreter": "sh",
        "arguments": []
      },
      "authentication": {
        "statusCommands": [
          "codex login status"
        ],
        "discoveries": [
          {
            "displayName": "Codex account",
            "statusCommand": "codex login status"
          }
        ],
        "methods": [
          {
            "id": "chatgpt",
            "displayName": "Sign in with Codex",
            "kind": "device-code",
            "command": "codex login --device-auth",
            "acceptsInput": false
          },
          {
            "id": "openai-api-key",
            "displayName": "Use an OpenAI API key",
            "kind": "api-key",
            "command": "codex login --with-api-key",
            "acceptsInput": true,
            "inputLabel": "OpenAI API key",
            "inputSecret": true
          }
        ]
      },
      "capabilities": [
        "conversations",
        "resume",
        "permissions",
        "attachments"
      ]
    },
    {
      "id": "claude_code",
      "displayName": "Claude Code",
      "transport": "acp",
      "command": "claude-agent-acp",
      "arguments": [],
      "cliCommand": "claude",
      "adapterPackage": "@agentclientprotocol/claude-agent-acp",
      "minimumAdapterVersion": "0.81.2",
      "install": {
        "kind": "official-script",
        "source": "https://claude.ai/install.sh",
        "command": "curl -fsSL https://claude.ai/install.sh | bash",
        "interpreter": "bash",
        "arguments": []
      },
      "authentication": {
        "statusCommands": [
          "claude auth status --json >/dev/null"
        ],
        "discoveries": [
          {
            "displayName": "Claude account",
            "statusCommand": "claude auth status --json >/dev/null"
          }
        ],
        "methods": [
          {
            "id": "claude-account",
            "displayName": "Sign in with Claude",
            "kind": "browser-code",
            "command": "claude auth login --claudeai",
            "acceptsInput": true,
            "inputLabel": "Authorization code"
          },
          {
            "id": "anthropic-console",
            "displayName": "Sign in with Anthropic Console",
            "kind": "browser-code",
            "command": "claude auth login --console",
            "acceptsInput": true,
            "inputLabel": "Authorization code"
          }
        ]
      },
      "capabilities": [
        "conversations",
        "resume",
        "permissions",
        "attachments"
      ]
    },
    {
      "id": "grok_build",
      "displayName": "Grok Build",
      "transport": "agent-stdio",
      "command": "grok",
      "arguments": [
        "--permission-mode",
        "auto",
        "agent",
        "stdio"
      ],
      "cliCommand": "grok",
      "transportCheckCommand": "grok agent stdio --help",
      "install": {
        "kind": "official-script",
        "source": "https://x.ai/cli/install.sh",
        "command": "curl -fsSL https://x.ai/cli/install.sh | bash",
        "interpreter": "bash",
        "arguments": []
      },
      "authentication": {
        "statusCommands": [
          "grok models 2>/dev/null | grep -q '^You are logged in'"
        ],
        "discoveries": [
          {
            "displayName": "Grok account",
            "statusCommand": "grok models 2>/dev/null | grep -q '^You are logged in'"
          }
        ],
        "methods": [
          {
            "id": "grok-account",
            "displayName": "Sign in with Grok",
            "kind": "device-code",
            "command": "grok login --device-auth",
            "acceptsInput": false
          }
        ]
      },
      "capabilities": [
        "conversations",
        "resume",
        "permissions"
      ]
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "transport": "opencode-v2",
      "command": "opencode",
      "arguments": [],
      "cliCommand": "opencode",
      "transportCheckCommand": "opencode --version",
      "install": {
        "kind": "npm-global",
        "package": "@opencode/cli@2",
        "source": "https://registry.npmjs.org/@opencode/cli",
        "arguments": [],
        "command": "npm install -g @opencode/cli@2"
      },
      "authentication": {
        "statusCommands": [],
        "discoveries": [],
        "methods": []
      },
      "capabilities": [
        "conversations",
        "resume",
        "permissions",
        "attachments",
        "shared-sessions",
        "server"
      ]
    }
  ]
}
