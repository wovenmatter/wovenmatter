{
  "harnesses": [
    {
      "id": "codex",
      "latestPackage": "@openai/codex",
      "displayName": "Codex",
      "transport": "acp",
      "command": "codex-acp",
      "arguments": [],
      "cliCommand": "codex",
      "adapterPackage": "@agentclientprotocol/codex-acp",
      "install": {
        "kind": "official-script",
        "source": "https://chatgpt.com/codex/install.sh",
        "command": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
        "interpreter": "sh",
        "arguments": []
      },
      "update": {
        "command": "codex update",
        "arguments": [
          "update"
        ]
      },
      "authentication": {
        "statusCommands": [
          "codex login status"
        ],
        "signOutCommand": "codex logout",
        "discoveries": [
          {
            "displayName": "Codex account",
            "statusCommand": "codex login status"
          }
        ],
        "methods": [
          {
            "id": "chatgpt",
            "displayName": "Sign in with Codex",
            "kind": "device-code",
            "command": "codex login --device-auth",
            "acceptsInput": false
          },
          {
            "id": "openai-api-key",
            "displayName": "Use an OpenAI API key",
            "kind": "api-key",
            "command": "codex login --with-api-key",
            "acceptsInput": true,
            "inputLabel": "OpenAI API key",
            "inputSecret": true
          }
        ]
      },
      "runtime": "codex"
    },
    {
      "id": "claude_code",
      "latestPackage": "@anthropic-ai/claude-code",
      "displayName": "Claude Code",
      "transport": "acp",
      "command": "claude-agent-acp",
      "arguments": [],
      "cliCommand": "claude",
      "adapterPackage": "@agentclientprotocol/claude-agent-acp",
      "install": {
        "kind": "official-script",
        "source": "https://claude.ai/install.sh",
        "command": "curl -fsSL https://claude.ai/install.sh | bash -s -- latest",
        "interpreter": "bash",
        "arguments": [
          "latest"
        ]
      },
      "update": {
        "command": "claude update",
        "arguments": [
          "update"
        ]
      },
      "authentication": {
        "statusCommands": [
          "claude auth status --json"
        ],
        "signOutCommand": "claude auth logout",
        "discoveries": [
          {
            "displayName": "Claude account",
            "statusCommand": "claude auth status --json"
          }
        ],
        "methods": [
          {
            "id": "claude-account",
            "displayName": "Sign in with Claude",
            "kind": "browser-code",
            "command": "claude auth login --claudeai",
            "acceptsInput": true,
            "inputLabel": "Authorization code"
          },
          {
            "id": "anthropic-console",
            "displayName": "Sign in with Anthropic Console",
            "kind": "browser-code",
            "command": "claude auth login --console",
            "acceptsInput": true,
            "inputLabel": "Authorization code"
          }
        ]
      },
      "runtime": "claudeCode"
    },
    {
      "id": "grok_build",
      "latestPackage": "@xai-official/grok",
      "displayName": "Grok Build",
      "transport": "agent-stdio",
      "command": "grok",
      "arguments": [
        "agent",
        "stdio"
      ],
      "cliCommand": "grok",
      "transportCheckCommand": "grok agent stdio --help",
      "install": {
        "kind": "official-script",
        "source": "https://x.ai/cli/install.sh",
        "command": "curl -fsSL https://x.ai/cli/install.sh | bash",
        "interpreter": "bash",
        "arguments": []
      },
      "update": {
        "command": "grok update",
        "arguments": [
          "update"
        ]
      },
      "authentication": {
        "statusCommands": [
          "grok models 2>/dev/null | grep -q '^You are logged in'"
        ],
        "signOutCommand": "grok logout",
        "discoveries": [
          {
            "displayName": "Grok account",
            "statusCommand": "grok models 2>/dev/null | grep -q '^You are logged in'"
          }
        ],
        "methods": [
          {
            "id": "grok-account",
            "displayName": "Sign in with Grok",
            "kind": "device-code",
            "command": "grok login --device-auth",
            "acceptsInput": false
          }
        ]
      },
      "runtime": "grokBuild",
      "permissionModes": [
        {
          "id": "default",
          "name": "Ask"
        },
        {
          "id": "acceptEdits",
          "name": "Accept edits"
        },
        {
          "id": "auto",
          "name": "Auto"
        },
        {
          "id": "dontAsk",
          "name": "Don't ask"
        },
        {
          "id": "bypassPermissions",
          "name": "Bypass permissions"
        },
        {
          "id": "plan",
          "name": "Plan"
        }
      ],
      "defaultPermission": "auto"
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "transport": "opencode",
      "command": "opencode",
      "arguments": [],
      "cliCommand": "opencode",
      "install": {
        "kind": "official-script",
        "source": "https://opencode.ai/v2/install",
        "command": "curl -fsSL https://opencode.ai/v2/install | bash",
        "interpreter": "bash",
        "arguments": []
      },
      "update": {
        "command": "opencode upgrade",
        "arguments": [
          "upgrade"
        ]
      },
      "authentication": {
        "statusCommands": [],
        "discoveries": [],
        "methods": []
      },
      "runtime": "openCode"
    },
    {
      "id": "pi_durable",
      "latestPackage": "@earendil-works/pi-durable",
      "runtime": "piDurable",
      "displayName": "Pi Durable",
      "transport": "acp",
      "command": "node",
      "arguments": [
        "src/main.mjs"
      ]
    }
  ]
}
