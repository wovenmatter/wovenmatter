{
  "name": "wovenmatter-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Woven Matter bots runtime: many bots in one Node process on Pi Durable, tools in per-bot containers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "wovenmatter-bots": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node test/require-node.mjs && tsc -p tsconfig.json && vitest run",
    "test:engine": "node test/require-node.mjs && vitest run test/engine-integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.323",
    "@earendil-works/chord": ">=1.5.2",
    "@earendil-works/pi-ai": ">=1.5.2",
    "@earendil-works/pi-durable": ">=1.5.2",
    "typebox": ">=1.4.7",
    "undici": ">=8.12.4",
    "ws": ">=8.23.0",
    "zod": ">=4.6.7"
  },
  "devDependencies": {
    "@types/node": ">=26.6.6",
    "@types/ws": ">=8.18.2",
    "typescript": ">=7.0.2",
    "vitest": ">=5.1.0"
  },
  "overrides": {
    "@earendil-works/pi-ai": {
      "openai": ">=7.56.0",
      "@anthropic-ai/sdk": ">=1.8.0",
      "@google/genai": ">=3.3.0",
      "@aws-sdk/client-bedrock-runtime": ">=3.1168.0",
      "@smithy/node-http-handler": ">=4.14.2",
      "@aws-sdk/token-providers": ">=3.1168.0"
    },
    "@earendil-works/chord": {
      "ws": "$ws"
    }
  }
}
