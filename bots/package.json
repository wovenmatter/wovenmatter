{
  "name": "wovenmatter-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Woven Matter bots runtime: every bot in one Node process on Pi Durable, tools in per-bot containers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "wovenmatter-bots": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node test/require-node.mjs && tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.332",
    "@earendil-works/chord": ">=1.6.1",
    "@earendil-works/pi-ai": ">=1.6.1",
    "@earendil-works/pi-durable": ">=1.6.1",
    "typebox": ">=1.4.7",
    "undici": ">=8.13.1",
    "ws": ">=8.23.0",
    "zod": ">=4.6.7"
  },
  "devDependencies": {
    "@types/node": ">=26.6.10",
    "@types/ws": ">=8.18.2",
    "typescript": ">=7.0.2",
    "vitest": ">=5.1.2"
  }
}
