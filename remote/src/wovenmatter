#!/usr/bin/env python3
"""Owner-local data tools remain available to scheduled agents without the Mac."""
import importlib.util
import json
import os
from pathlib import Path
import sys
import socket

args = sys.argv[1:]
if not args or args[0] in ('help', '--help'):
    print('wovenmatter databases list|create|query|execute\n  create --title NAME\n  query|execute --database-id ID --query SQL\nThese tools operate on this workspace\'s writable databases while the Mac is offline.')
    sys.exit(0)
if args[0] == 'goals':
    if len(args) < 2 or args[1] in ('help', '--help'):
        print('wovenmatter goals get|set|pause|resume|clear|complete|block|checkpoint\n  set --objective TEXT [--token-budget N] [--turn-budget N] --request-id UUID\n  Other mutations: --id ID [--evidence TEXT] --request-id UUID')
        sys.exit(0)
    try:
        # Bound by the execution owner to this native working directory and run.
        context = json.loads((Path.cwd() / '.wovenmatter-goal-context.json').read_text())
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(30)
            connection.connect(context['socket'])
            connection.sendall((json.dumps({**context, 'arguments': args}) + '\n').encode())
            result = b''
            while b'\n' not in result:
                chunk = connection.recv(16384)
                if not chunk: break
                result += chunk
                if len(result) > 65536: raise ValueError('Goal response exceeds the supported size.')
        response = json.loads(result)
        print(json.dumps(response))
        sys.exit(0 if response.get('success') else 1)
    except Exception as error:
        sys.exit(str(error))
if args[0] != 'databases' or len(args) < 2:
    sys.exit('This owner-local CLI supports databases and goals. Other Woven tools require a connected session.')
options = dict(zip(args[2::2], args[3::2]))
request = {'action': args[1], 'name': options.get('--title'), 'databaseID': options.get('--database-id'), 'sql': options.get('--query')}
helper = Path(__file__).resolve().with_name('database-catalog.py')
spec = importlib.util.spec_from_file_location('managed_databases', helper)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
try:
    print(json.dumps(module.operation(os.environ.get('WOVENMATTER_DATA_DIRECTORY', str(Path.home() / '.local/share/wovenmatter/databases')), request)))
except Exception as error:
    sys.exit(str(error))
