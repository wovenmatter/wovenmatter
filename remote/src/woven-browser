#!/usr/bin/env node
// Uses the workspace's existing administrative capability; never prints its token.
const action = process.argv[2]
if (!['endpoint', 'tabs'].includes(action) || process.argv.length !== 3) {
  console.log('woven-browser endpoint  Start/reuse the shared workspace browser and print its local CDP endpoint.\nwoven-browser tabs      List shared tabs without starting a browser.\nConnect with playwright.chromium.connectOverCDP(endpoint), then use browser.contexts()[0].newPage().\nDisconnect with browser.close(); shared tabs remain visible in Woven Matter until closed explicitly.\nIndependent chromium.launch() browsers are private and are not shown in the app.')
  process.exit(action === '--help' || action === 'help' || !action ? 0 : 64)
}
const port = Number(process.env.WOVENMATTER_LISTEN_PORT ?? 7337)
if (!Number.isInteger(port) || port < 1 || port > 65535 || !process.env.WOVENMATTER_API_TOKEN) {
  console.error('This command must run inside a Woven Matter remote workspace.')
  process.exit(1)
}
try {
  const response = await fetch(`http://127.0.0.1:${port}/v1/browser/${action === 'endpoint' ? 'connect' : 'tabs'}`, {
    method: action === 'endpoint' ? 'POST' : 'GET', redirect: 'error',
    headers: { Authorization: `Bearer ${process.env.WOVENMATTER_API_TOKEN}` }, signal: AbortSignal.timeout(20000),
  })
  if (!response.ok) throw new Error('unavailable')
  const result = await response.json()
  console.log(action === 'endpoint' ? result.endpoint : JSON.stringify(result))
} catch {
  console.error('The workspace browser is unavailable. Check that the workspace service is running and up to date.')
  process.exitCode = 1
}
